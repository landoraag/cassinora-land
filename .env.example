# Copie para .env (o .env não vai para o GitHub) e preencha com os dados do app Web do Firebase:
# Firebase Console → Configurações do projeto (engrenagem) → Seus apps → app Web → firebaseConfig
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=cassinora-land.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=cassinora-land
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
